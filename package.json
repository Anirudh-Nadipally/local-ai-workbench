{
  "name": "local-azure-ai-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "An open-source, local-first Azure AI workspace for chat, files, reviewed memory, and bounded multi-model synthesis.",
  "license": "MIT",
  "homepage": "https://github.com/Anirudh-Nadipally/local-ai-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anirudh-Nadipally/local-ai-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/Anirudh-Nadipally/local-ai-workbench/issues"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev -H 127.0.0.1\" \"node --watch --import tsx src/worker/index.ts\"",
    "dev:web": "next dev -H 127.0.0.1",
    "worker": "node --import tsx src/worker/index.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "connection:probe": "node --import tsx scripts/probe-connection.ts",
    "build": "next build --webpack",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"next start -H 127.0.0.1\" \"node --import tsx src/worker/index.ts\"",
    "app": "npm run db:migrate && npm run start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.77",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@ai-sdk/react": "^3.0.211",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^6.0.209",
    "better-sqlite3": "^12.11.1",
    "busboy": "^1.6.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.3",
    "csv-parse": "^7.0.0",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "mime-types": "^3.0.2",
    "motion": "^12.41.0",
    "nanoid": "^5.1.15",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.0",
    "pdfjs-dist": "^5.6.205",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
