{
  "name": "ai-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A local AI workspace for conversations, documents, reviewed project memory, and portable handoffs.",
  "license": "MIT",
  "homepage": "https://github.com/Anirudh-Nadipally/local-ai-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anirudh-Nadipally/local-ai-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/Anirudh-Nadipally/local-ai-workbench/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker \"next dev -H 127.0.0.1\" \"tsx watch src/worker.ts\"",
    "dev:web": "next dev -H 127.0.0.1",
    "build": "next build --webpack",
    "start": "concurrently -k -n web,worker \"next start -H 127.0.0.1\" \"tsx src/worker.ts\"",
    "worker": "tsx src/worker.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:recovery": "WORKBENCH_BROWSER_TEST=1 vitest run tests/draft-browser.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.127",
    "@ai-sdk/azure": "^3.0.133",
    "ai": "^6.0.300",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.5",
    "csv-parse": "^7.0.3",
    "hast-util-to-html": "9.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "streamdown": "^2.7.0",
    "tsx": "^4.22.4",
    "unified": "11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
